# NMAKE-style final-link sheet generated by tools/histbuild.py.
# The Python entry point freshly compiles/assembles accepted sources, builds
# GAME.LIB, and stages this DOS-side bundle under build/histbuild/<run>/dos/.

LINK = LINK
EXEPACK = EXEPACK
LIB = LIB

EXPLICIT_OBJECTS = @EXPLICIT_OBJECTS@
GAME_OBJECTS = @GAME_OBJECTS@
LINK_LIBRARIES = @LINK_LIBRARIES@

all: PACKED.EXE

GAME.LIB: MLIBCR.LIB GAME.RSP $(GAME_OBJECTS)
	IF EXIST GAME.LIB DEL GAME.LIB
	COPY MLIBCR.LIB GAME.LIB
	$(LIB) @GAME.RSP

RESULT.EXE: LINK.RSP $(EXPLICIT_OBJECTS) $(LINK_LIBRARIES)
	$(LINK) @LINK.RSP

PACKED.EXE: RESULT.EXE
	$(EXEPACK) RESULT.EXE PACKED.EXE
